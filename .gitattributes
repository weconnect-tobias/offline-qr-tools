# Line endings as used in this project. Vendored files must stay byte-identical
# to the npm originals, otherwise the SHA-384 checks in vendor/manifest.json fail.
* text=auto eol=lf
*.html      text eol=crlf
*.css       text eol=crlf
js/**/*.js  text eol=crlf
*.ps1       text eol=crlf
*.svg       text eol=lf
vendor/**   -text
